{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MarketData": {
    "PrimaryProvider": "Dhan",
    "EnabledProviders": [ "Dhan", "Zerodha", "Groww" ],
    "CsvDataRoot": "tests/fixtures/market-data"
  },
  "Risk": {
    "CapitalAmount": 20000,
    "MinPlannedRiskAmount": 200,
    "MaxPlannedRiskAmount": 400,
    "MaxActiveSignals": 3,
    "AllowSmallRiskAlerts": false
  },
  "EodScanner": {
    "LookbackDays": 20,
    "MinimumAverageTradedValue": 1000000,
    "MinimumVolumeExpansionRatio": 1.5,
    "NearHighCloseThreshold": 0.8,
    "NearLowCloseThreshold": 0.2,
    "MaxDailyDataAgeHours": 36
  }
}
